# ==============================================================================
# PM Operations Agent — Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=true

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Centralized Dry Run Mode (true = simulation only, no external mutating calls)
DRY_RUN=true

# Database Path (SQLite)
DB_PATH=data/pm_operations.db

# ------------------------------------------------------------------------------
# Connector: Jira Cloud REST API (Primary ingestion: Polling, Optional: Webhook)
# ------------------------------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=pm-agent@your-domain.com
JIRA_API_TOKEN=your_jira_api_token_here

# Jira Polling Settings (Primary Event Ingestion Mechanism)
JIRA_POLLING_ENABLED=true
JIRA_POLLING_INTERVAL_MINUTES=2
JIRA_POLLING_BATCH_SIZE=50
JIRA_POLLING_LOOKBACK_MINUTES=5
JIRA_POLLING_INITIAL_LOOKBACK_MINUTES=60
# Team-scoped Jira group monitoring (e.g. Mursaleen Cluster)
JIRA_TEAM_GROUP=Mursaleen Cluster

# Optional Fast Path: Jira Webhooks
JIRA_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Connector: Discord Webhook & Interactive Bot (/pm slash commands)
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Interactive Discord Bot Gateway & Slash Commands
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_GUILD_ID=your_discord_server_guild_id_here
DISCORD_PM_COMMAND_ENABLED=true
DISCORD_PM_ALLOWED_USERS=your_numeric_discord_user_id_here


# ------------------------------------------------------------------------------
# Connector: Mattermost REST API (OPTIONAL — leave empty if not configured)
# The PM Operations Agent operates fully without Mattermost credentials.
# When unconfigured, Mattermost actions are safely skipped and recorded in audit log.
# ------------------------------------------------------------------------------
MATTERMOST_URL=
MATTERMOST_TOKEN=
MATTERMOST_TEAM_NAME=

# ------------------------------------------------------------------------------
# Personal User Identity (Optional overrides; defaults to /rest/api/3/myself)
# ------------------------------------------------------------------------------
# MY_JIRA_ACCOUNT_ID=
# MY_JIRA_EMAIL=
# MY_JIRA_DISPLAY_NAME=

# ------------------------------------------------------------------------------
# Notification & Rule Policies
# ------------------------------------------------------------------------------
STALE_TASK_HOURS=24
STALE_TASK_NOTIFY_ASSIGNEE=true
STALE_TASK_NOTIFY_PM=false
OVERDUE_NOTIFY_PM=false
WORKFLOW_VIOLATION_NOTIFY_PM=true
NOTIFICATION_COOLDOWN_MINUTES=60
COMMENT_NOTIFY_ALL=false
ASSIGNMENT_NOTIFY_TEAM=true

# ------------------------------------------------------------------------------
# Daily Overdue Digest Settings
# ------------------------------------------------------------------------------
OVERDUE_DIGEST_ENABLED=false
OVERDUE_DIGEST_TIME=09:00
OVERDUE_DIGEST_TIMEZONE=Asia/Karachi

# ------------------------------------------------------------------------------
# Daily PM Attention Digest Settings
# ------------------------------------------------------------------------------
PM_ATTENTION_DIGEST_ENABLED=false
PM_ATTENTION_DIGEST_TIME=09:00
PM_ATTENTION_DIGEST_TIMEZONE=Asia/Karachi


# ------------------------------------------------------------------------------
# Daily Worklog Report Settings
# ------------------------------------------------------------------------------
DAILY_WORKLOG_REPORT_ENABLED=true
DAILY_WORKLOG_REPORT_TIME=18:00
DAILY_WORKLOG_REPORT_TIMEZONE=Asia/Karachi
DAILY_WORKLOG_REPORT_CHANNEL=pm-alerts
# Comma-separated Jira account IDs excluded from daily worklog reporting (Aqib Khan, Abdul Subhan, Muhammad Mursaleen, Syed Muhammad Usman)
DAILY_WORKLOG_EXCLUDED_ACCOUNT_IDS=712020:566cad70-4a54-42bc-bf36-0c6132fe3cf0,712020:1b564792-a3ab-447c-951d-17aa5507b946,712020:1b564792-a3af-447c-951d-17aa5507b946,557058:8b3f9c31-7d88-473a-9351-abacc5b84933,5f83e3937d9637006ffd0436

# ------------------------------------------------------------------------------
# Scheduler Settings (In-process background evaluation of time-based rules)
# ------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# ------------------------------------------------------------------------------
# HTTP Client Network Settings
# ------------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
