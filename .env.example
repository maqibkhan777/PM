# ==============================================================================
# PM Operations Agent — Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=true

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Centralized Dry Run Mode (true = simulation only, no external mutating calls)
DRY_RUN=true

# Database Path (SQLite)
DB_PATH=data/pm_operations.db

# ------------------------------------------------------------------------------
# Connector: Jira Cloud REST API
# ------------------------------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=pm-agent@your-domain.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Connector: Discord Webhook (Outbound notifications & alerts)
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# ------------------------------------------------------------------------------
# Connector: Mattermost REST API (Direct messages & channel alerts)
# ------------------------------------------------------------------------------
MATTERMOST_URL=https://mattermost.your-domain.com
MATTERMOST_TOKEN=your_mattermost_bot_token_here
MATTERMOST_TEAM_NAME=main

# ------------------------------------------------------------------------------
# Notification & Rule Policies
# ------------------------------------------------------------------------------
STALE_TASK_HOURS=24
STALE_TASK_NOTIFY_ASSIGNEE=true
STALE_TASK_NOTIFY_PM=true
OVERDUE_NOTIFY_PM=true
WORKFLOW_VIOLATION_NOTIFY_PM=true
NOTIFICATION_COOLDOWN_MINUTES=60

# ------------------------------------------------------------------------------
# Scheduler Settings (In-process background evaluation of time-based rules)
# ------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# ------------------------------------------------------------------------------
# HTTP Client Network Settings
# ------------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
