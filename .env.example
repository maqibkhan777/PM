# ==============================================================================
# PM Operations Agent — Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=true

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Centralized Dry Run Mode (true = simulation only, no external mutating calls)
DRY_RUN=true

# Database Path (SQLite)
DB_PATH=data/pm_operations.db

# ------------------------------------------------------------------------------
# Connector: Jira Cloud REST API (Primary ingestion: Polling, Optional: Webhook)
# ------------------------------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=pm-agent@your-domain.com
JIRA_API_TOKEN=your_jira_api_token_here

# Jira Polling Settings (Primary Event Ingestion Mechanism)
JIRA_POLLING_ENABLED=true
JIRA_POLLING_INTERVAL_MINUTES=2
JIRA_POLLING_BATCH_SIZE=50
JIRA_POLLING_LOOKBACK_MINUTES=5
JIRA_POLLING_INITIAL_LOOKBACK_MINUTES=60

# Optional Fast Path: Jira Webhooks
JIRA_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Connector: Discord Webhook (Outbound notifications & alerts)
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# ------------------------------------------------------------------------------
# Connector: Mattermost REST API (OPTIONAL — leave empty if not configured)
# The PM Operations Agent operates fully without Mattermost credentials.
# When unconfigured, Mattermost actions are safely skipped and recorded in audit log.
# ------------------------------------------------------------------------------
MATTERMOST_URL=
MATTERMOST_TOKEN=
MATTERMOST_TEAM_NAME=

# ------------------------------------------------------------------------------
# Notification & Rule Policies
# ------------------------------------------------------------------------------
STALE_TASK_HOURS=24
STALE_TASK_NOTIFY_ASSIGNEE=true
STALE_TASK_NOTIFY_PM=true
OVERDUE_NOTIFY_PM=true
WORKFLOW_VIOLATION_NOTIFY_PM=true
NOTIFICATION_COOLDOWN_MINUTES=60

# ------------------------------------------------------------------------------
# Scheduler Settings (In-process background evaluation of time-based rules)
# ------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# ------------------------------------------------------------------------------
# HTTP Client Network Settings
# ------------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
